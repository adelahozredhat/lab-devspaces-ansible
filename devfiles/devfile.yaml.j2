# cspell: disable=devspaces
{#
  Plantilla Ansible (Jinja2) de Devfile 2.2.2 para OpenShift Dev Spaces.

  Variables (opcionales):
    git_projects_base  URL base de los repositorios, sin barra final.
                       Por defecto: https://github.com/adelahozredhat
                       En el laboratorio Gitea:
                         {{ gitea }}/{{ gitea_user }}
                         p. ej. https://repository-gitea-operator.apps.<cluster>/lab-user-1
    git_revision       Rama a clonar (por defecto: master)
    gitea              URL de Gitea (si se define junto a gitea_user, sustituye git_projects_base)
    gitea_user         Usuario Gitea (p. ej. lab-user-1)
    workspace_node     Hostname del worker donde pinchar este workspace (round-robin
                       en el playbook). Evita que todos caigan en el mismo nodo.
#}
{% set git_projects = [
  'lab-devspaces-ansible-instruction',
  'lab-devspaces-ansible-exercise1',
  'lab-devspaces-ansible-exercise2',
  'lab-devspaces-ansible-exercise3',
  'lab-devspaces-ansible-exercise4',
  'lab-devspaces-ansible-exercise5',
] %}
{% set git_projects_base = (gitea ~ '/' ~ gitea_user) if (gitea is defined and gitea_user is defined) else (git_projects_base | default('https://github.com/adelahozredhat')) %}
{% set git_revision = git_revision | default('master') %}
schemaVersion: 2.2.2
metadata:
  name: ansible-demo
# Pin each student to a worker (set by the playbook). Topology spread is a
# fallback; DevWorkspace drops namespaceSelector so TSC alone does not spread
# pods that live in different userN-devspaces namespaces.
attributes:
  pod-overrides:
    spec:
{% if workspace_node is defined and workspace_node %}
      nodeSelector:
        kubernetes.io/hostname: "{{ workspace_node }}"
{% endif %}
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              controller.devfile.io/devworkspace_name: ansible-demo
          namespaceSelector: {}
projects:
{% for project in git_projects %}
  - name: {{ project }}
    git:
      remotes:
        origin: '{{ git_projects_base }}/{{ project }}.git'
      checkoutFrom:
        revision: {{ git_revision }}
{% endfor %}
components:
  - name: tooling-container
    container:
      image: ghcr.io/ansible/ansible-devspaces@sha256:e56d86ca04d9d84d3079b12c227cc53b08a11a580d532f5a63c8e16cfddeb3ba
      memoryRequest: 256M
      memoryLimit: 6Gi
      cpuRequest: 250m
      cpuLimit: 2000m
      args: ['tail', '-f', '/dev/null']
      env:
        - name: 'ANSIBLE_COLLECTIONS_PATH'
          value: '~/.ansible/collections:/usr/share/ansible/collections:/projects/ansible-devspaces-demo/collections'
        - name: 'KUBEDOCK_ENABLED'
          value: "true"
